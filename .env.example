# Open Learning environment variables.
# Copy to .env.local and fill in. Never commit .env.local. Leave a value empty to disable that feature;
# the app still runs and shows a "not configured" notice where the feature would be.

# ---------- Site ----------
# Currently not read by src (callback origin comes from the request host). Kept for future absolute URLs.
NEXT_PUBLIC_SITE_URL=

# ---------- Supabase (Project settings -> API) ----------
# Public (sent to the browser). Required for sign-in, dashboard, videos, groups, friends.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used by the auth callback to finish onboarding. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google OAuth (Google Cloud Console -> Credentials) ----------
# The app does NOT read these: paste them into Supabase -> Authentication -> Providers -> Google
# (redirect URI: https://<project-ref>.supabase.co/auth/v1/callback). Listed here so they are tracked.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- LiveKit (voice rooms + friend calls) ----------
# All SERVER ONLY. The server returns the URL to signed-in, authorised members with their token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Google Sheets video import (SERVER ONLY) ----------
# Option A: API key, for sheets shared "Anyone with the link can view".
GOOGLE_SHEETS_API_KEY=
# Option B (private sheets): service account; share the sheet with its email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------- Scheduled jobs (SERVER ONLY) ----------
# Long random string (e.g. `openssl rand -hex 32`). When set in Vercel, Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" to /api/cron/purge-stories (daily, see vercel.json). Without it the route returns 401.
CRON_SECRET=
